<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_PropertySheetDisplayName>BCU User Macros</_PropertySheetDisplayName>
  </PropertyGroup>
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <BcuFrameworkDir>C:\toolbase\bcu\2.6.0\</BcuFrameworkDir>
  </PropertyGroup>
  <ItemGroup>
    <BuildMacro Include="BcuFrameworkDir">
      <Value>$(BcuFrameworkDir)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>
  </ItemGroup>
</Project>
