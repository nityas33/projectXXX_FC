      <ts_doc description="Mo_SyC_stSub determines which process should be executed for the TC:  &#xA;MO_SYC_REINI                           1U  &#xA;MO_SYC_PROC                           2U  &#xA;MO_SYC_PROC_EXTDTSK          4U  &#xA;MO_SYC_DIAG                            8U  &#xA;MO_SYC_POSTDRIVE                16U  &#xA;MO_SYC_DSM_CLEAR               32U  &#xA;MO_SYC_INI                              64U"/>
      <ts_setchannel channel="Mo_SyC_stSub" continuous="true" source="64"/>
      <ts_doc description="correction factor for compensation of Scheduling differences between executed Fc process in UDE and TPT teststepsize (= FC process Scheduling/Teststepsize)"/>
      <ts_wait time="@"/>
      <ts_if_expr source="(CHRGNFCTSFTY_CCSACINLET_SC || CHRGNFCTSFTY_CCSDCINLET_SC)"/>
      <ts_compare actions="Equal" channel="MonEgyChrgnInlet_ratPwmCcsCtpLocCpl" source="0XFFFF" tolerance="0" type="always"/>
